# ===================================================================
# KIEMJOB BACKEND - ENVIRONMENT VARIABLES TEMPLATE (.env.example)
# Sao chép file này thành .env để cấu hình môi trường chạy cục bộ hoặc container.
# Trên AWS ECS, các giá trị này sẽ được inject từ AWS Secrets Manager hoặc SSM Parameter Store.
# ===================================================================

# Spring Profile ('dev' hoặc 'prod')
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database (PostgreSQL / AWS RDS)
DB_URL=jdbc:postgresql://localhost:5432/kiemjob_1
DB_USERNAME=postgres
DB_PASSWORD=your_secure_db_password
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5

# Security & CORS
# Khi nhiều domain phân tách bằng dấu phẩy, không dùng wildcard '*' khi cookie credentials=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false

# JWT Secret (Base64-encoded HMAC-SHA512 key, tối thiểu 64 bytes = 512 bits)
# Tạo bằng lệnh: openssl rand -base64 64
JWT_SECRET=c29tZV9zdXBlcl9zZWNyZXRfa2V5X2Zvcl9qd3RfaHNiYXNlNjRfbWluaW11bV82NF9ieXRlc19leGFtcGxlXzEyMzQ1Njc4OTA=

# OTP Pepper (Chuỗi bí mật dùng băm OTP trong cơ sở dữ liệu)
OTP_PEPPER=your_random_otp_pepper_secret_value

# Email SMTP (Gmail App Password hoặc Amazon SES SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password

# AWS S3 Storage
# Trên AWS ECS, bỏ trống AWS_ACCESS_KEY_ID và AWS_SECRET_ACCESS_KEY để tự động nhận IAM Task Role
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=kiemjob-media-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# VNPay Payment Gateway
VNPAY_TMN_CODE=YOUR_VNPAY_TMN_CODE
VNPAY_HASH_SECRET=YOUR_VNPAY_HASH_SECRET
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_IPN_URL=http://localhost:8080/api/payments/vnpay/ipn

# Groq AI Service (via Spring AI 2.0 OpenAI Starter)
# LƯU Ý: Vui lòng kiểm tra https://console.groq.com/docs/models để cập nhật tên mô hình còn hiệu lực (vd: openai/gpt-oss-120b)
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30s

# Spring AI Retry Configuration
SPRING_AI_RETRY_MAX_ATTEMPTS=3
SPRING_AI_RETRY_INITIAL_INTERVAL=1s
SPRING_AI_RETRY_MULTIPLIER=2.0
SPRING_AI_RETRY_MAX_INTERVAL=10s

# AI Rate Limiting & Abuse Protection
AI_RATE_LIMIT_PER_MINUTE=10
AI_RATE_LIMIT_WINDOW_SECONDS=60
MODERATION_RISK_THRESHOLD=0.7
MODERATION_MAX_CHECKS_PER_HOUR=5

# Job Lifecycle Scheduler & ShedLock (Đồng bộ đa container ECS)
SCHEDULER_ENABLED=true
SCHEDULER_EXPIRE_JOBS_CRON=0 0 * * * *
SCHEDULER_CLEAR_FEATURED_CRON=0 0 * * * *
SCHEDULER_REMINDER_CRON=0 0 8 * * *
SCHEDULER_REMINDER_ZONE=Asia/Ho_Chi_Minh



